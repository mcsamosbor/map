VITE_SUPABASE_URL=https://ваш-проект.supabase.co
VITE_SUPABASE_ANON_KEY=ваш-anon-ключ

# Бэкапы базы данных (scripts/backup-*.mjs)
# Connection string из дашборда: Settings -> Database -> Connection string -> URI
# (Session pooler или Direct connection; пароль должен быть percent-encoded)
SUPABASE_DB_URL=postgresql://postgres:пароль@db.ваш-проект.supabase.co:5432/postgres
# Приватный репозиторий для хранения бэкапов (owner/имя) и PAT с contents: read+write на него
BACKUP_REPO=owner/map-backups
BACKUP_REPO_TOKEN=github_pat_...